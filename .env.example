# 与参考项目同一个 PG 实例、同一个账号，只换库名
DATABASE_URL=postgres://user:password@host:5432/changan_monitor

# 参考项目所在的库，仅用于同步账号
SOURCE_DB_NAME=changan_social_data

# X / YouTube / Instagram / TikTok 共用，4 个平台都需要
TIKHUB_API_KEY=
TIKHUB_MIN_INTERVAL_MS=80

# db:sync-accounts 从参考库导入哪类账号；不影响监控（监控抓所有 active=true）
SYNC_ACCOUNT_TYPE=欧洲

# 滚动窗口和周期
MONITOR_WINDOW_HOURS=72
MONITOR_TIMEZONE=Asia/Shanghai
MONITOR_CONCURRENCY=3
MONITOR_ACCOUNT_TIMEOUT_MS=300000

# 浏览器
MONITOR_HEADLESS=0
MONITOR_USER_DATA_DIR=work/playwright-profile
MONITOR_CHROME_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Web 生产环境（Nginx 公网地址，scheme + host，不带路径）
PUBLIC_ORIGIN=
